<?xml version="1.0" encoding="utf-8"?>
<!-- The last row of Home when app_library is on: one frosted pill, centred under the grid, like the end of an
     iPhone's Home pages leading to the App Library. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="96dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <TextView
        android:id="@+id/btnLibrary"
        style="@style/TopButton"
        android:layout_gravity="center"
        android:layout_marginStart="0dp"
        android:paddingStart="18dp"
        android:paddingEnd="22dp"
        android:text="@string/app_library"
        android:drawableStart="@drawable/ic_apps"
        android:defaultFocusHighlightEnabled="false" />
</FrameLayout>
